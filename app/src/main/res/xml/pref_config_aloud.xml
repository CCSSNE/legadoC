<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <io.legado.app.lib.prefs.PreferenceCategory
        android:title="@string/aloud_config"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false"
        app:iconSpaceReserved="false">

        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="false"
            android:key="ignoreAudioFocus"
            android:summary="@string/ignore_audio_focus_summary"
            android:title="@string/ignore_audio_focus_title" />

        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="false"
            android:key="pauseReadAloudWhilePhoneCalls"
            android:summary="@string/pause_read_aloud_while_phone_calls_summary"
            android:title="@string/pause_read_aloud_while_phone_calls_title" />

        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="false"
            android:title="@string/read_aloud_wake_lock"
            android:summary="@string/read_aloud_wake_lock_summary"
            android:key="readAloudWakeLock"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="false"
            android:title="@string/pref_media_button_per_next"
            android:summary="@string/pref_media_button_per_next_summary"
            android:key="mediaButtonPerNext"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="false"
            android:title="@string/read_aloud_force_page_follow"
            android:summary="@string/read_aloud_force_page_follow_summary"
            android:key="forcePageFollow"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="false"
            android:title="@string/read_aloud_page_split"
            android:summary="@string/read_aloud_page_split_summary"
            android:key="pageSplit"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="false"
            android:title="@string/read_aloud_tts_wav_mode"
            android:summary="@string/read_aloud_tts_wav_mode_summary"
            android:key="ttsWavMode"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="false"
            android:dependency="ttsWavMode"
            android:title="@string/read_aloud_tts_realtime_cache"
            android:summary="@string/read_aloud_tts_realtime_cache_summary"
            android:key="ttsRealtimeCache"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.Preference
            android:key="ttsCacheSettings"
            android:summary="@string/tts_cache_settings_summary"
            android:title="@string/tts_cache_settings"
            app:iconSpaceReserved="false" />

        <!-- 页首按段：控制“页首”这个概念本身——从本页读/强制追页落到某一页时，
             起点是本页第一个字，还是本页第一个段落的第一个字。
             与上面的强制追页正交：强制追页决定“翻到哪页读哪页”，
             页首按段决定“这一页的页首落在哪”。 -->
        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="true"
            android:key="readAloudPageStartAtParagraph"
            android:summary="@string/read_aloud_page_start_at_paragraph_summary"
            android:title="@string/read_aloud_page_start_at_paragraph"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="false"
            android:title="@string/stream_read_aloud_audio"
            android:summary="@string/stream_read_aloud_audio_summary"
            android:key="streamReadAloudAudio"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="true"
            android:key="readAloudCoverRotation"
            android:summary="@string/read_aloud_cover_rotation_summary"
            android:title="@string/read_aloud_cover_rotation"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.Preference
            android:defaultValue="10000"
            android:dependency="readAloudCoverRotation"
            android:key="readAloudCoverRotationDuration"
            android:summary="@string/read_aloud_cover_rotation_duration_summary"
            android:title="@string/read_aloud_cover_rotation_duration"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.Preference
            android:defaultValue="3000"
            android:key="readAloudScrollFollowTimeout"
            android:summary="@string/read_aloud_scroll_follow_timeout_summary"
            android:title="@string/read_aloud_scroll_follow_timeout_title"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.Preference
            android:defaultValue="500"
            android:key="readAloudProgressPollInterval"
            android:summary="@string/read_aloud_progress_poll_interval_summary"
            android:title="@string/read_aloud_progress_poll_interval_title"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="true"
            android:key="readAloudHideFloatingWindow"
            android:summary="@string/read_aloud_hide_floating_window_summary"
            android:title="@string/read_aloud_hide_floating_window"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="false"
            android:key="readAloudHidePlaybackPanel"
            android:summary="@string/read_aloud_hide_playback_panel_summary"
            android:title="@string/read_aloud_hide_playback_panel"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.Preference
            android:defaultValue="10"
            android:key="readAloudPlaybackPanelDuration"
            android:summary="@string/read_aloud_playback_panel_duration_summary"
            android:title="@string/read_aloud_playback_panel_duration"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="false"
            android:key="readAloudHidePagePanel"
            android:summary="@string/read_aloud_hide_page_panel_summary"
            android:title="@string/read_aloud_hide_page_panel"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="true"
            android:key="readAloudPanelOnPageFooter"
            android:summary="@string/read_aloud_panel_on_page_footer_summary"
            android:title="@string/read_aloud_panel_on_page_footer"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.SwitchPreference
            android:defaultValue="false"
            android:key="readAloudFloatOnDesktop"
            android:summary="@string/read_aloud_float_on_desktop_summary"
            android:title="@string/read_aloud_float_on_desktop"
            app:iconSpaceReserved="false" />

        <io.legado.app.lib.prefs.Preference
            android:title="@string/sys_tts_config"
            android:summary="@string/sys_tts_config_summary"
            android:key="sysTtsConfig"
            app:iconSpaceReserved="false" />

    </io.legado.app.lib.prefs.PreferenceCategory>

</androidx.preference.PreferenceScreen>
