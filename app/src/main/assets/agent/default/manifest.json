{
  "id": "legado.reader",
  "name": "通用助手与陪读",
  "version": "1.1.0",
  "hostApiVersion": 1,
  "entry": "main.js",
  "dependencies": {"prompts": [], "skills": [], "plugins": {}},
  "prompts": {"reader.system": "prompts/system.md", "reader.memory": "prompts/memory.md"},
  "skills": {},
  "tools": [],
